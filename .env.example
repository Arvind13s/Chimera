# ══════════════════════════════════════════════════════════════
# Chimera v3.0 — Environment Configuration
# ══════════════════════════════════════════════════════════════

# ── LLM Keys (Groq — use 4-5 for rotation) ──────────────────
# Get keys at: https://console.groq.com/keys
GROQ_API_KEY=gsk_...

# ── Stock Video APIs ─────────────────────────────────────────
# Pexels: https://www.pexels.com/api/
PEXELS_API_KEY=your_pexels_key

# Pixabay: https://pixabay.com/api/docs/
PIXABAY_API_KEY=your_pixabay_key

# ── Music APIs ───────────────────────────────────────────────
# Jamendo (primary): https://developer.jamendo.com
JAMENDO_CLIENT_ID=your_jamendo_client_id

# Freesound: https://freesound.org/apiv2/apply/
FREESOUND_API_KEY=your_freesound_key

# Free Music Archive (optional)
FMA_API_KEY=your_fma_key

# ── MusicBrainz (no key needed for basic queries) ────────────
MUSICBRAINZ_APP_NAME=Chimera-AI-Video-Generator
MUSICBRAINZ_APP_VERSION=3.0.0
MUSICBRAINZ_CONTACT=https://github.com/Arvind13s/Chimera

# ── Authentication & OAuth ───────────────────────────────────
# Google OAuth: https://console.developers.google.com/
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_secret

# GitHub OAuth: https://github.com/settings/developers
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_secret

# Secret key for session token generation
AUTH_SECRET_KEY=change_this_to_a_random_string

# ── Email & OTP Verification (SMTP) ───────────────────────────
# For Gmail: Use smtp.gmail.com, port 587, your email, and a 16-character App Password (not your normal password)
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_FROM_NAME=Chimera Studio
SMTP_USE_TLS=true
# Leave blank or unconfigured for Dev Mode (OTP prints to terminal console)

# ── Advanced (optional) ─────────────────────────────────────
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_TEMPERATURE=0.8
# OUTPUT_DIR=./outputs
# VIDEO_THREADS=4
